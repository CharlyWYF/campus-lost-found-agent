# 复制为 .env 后填写。当前 Agent 不做规则降级：Key 缺失或 API 失败会直接报错。
# 任意 OpenAI 兼容接口即可：DeepSeek / OpenAI / 通义 / 本地 vLLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# 可选：固定演示日期，便于复现（不填则用本机时间）
# LF_DEMO_NOW=2026-11-26T16:00:00

# live：必须成功调用模型；auto：有 Key 就调用；mock 仅用于离线测试
LLM_MODE=live

# Docker 部署时映射到宿主机的端口（容器内部仍为 8000）
LF_HOST_PORT=8000

# 管理员模式密码（课程 demo 默认 admin123，请按需修改）
ADMIN_PASSWORD=admin123
ADMIN_NAME=值班老师
